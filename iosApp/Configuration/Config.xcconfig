TEAM_ID=

PRODUCT_NAME=MyApplication
// BUNDLE_ID_SUFFIX and APP_DISPLAY_NAME come from the per-environment file (Dev/Stage/Prod.xcconfig).
PRODUCT_BUNDLE_IDENTIFIER=com.anksoft.myapplication.MyApplication$(TEAM_ID)$(BUNDLE_ID_SUFFIX)
INFOPLIST_KEY_CFBundleDisplayName=$(APP_DISPLAY_NAME)

// VERSION_NAME and VERSION_CODE: single version source shared with Android and web.
#include "../../version.properties"
CURRENT_PROJECT_VERSION=$(VERSION_CODE)
MARKETING_VERSION=$(VERSION_NAME)

// Empty means demo mode in Dev. Override in Local.xcconfig (see Local.xcconfig.example).
// Stage.xcconfig and Prod.xcconfig reset it to empty after this file, so they ignore Local.xcconfig.
KMP_BACKEND_URL =

#include? "Local.xcconfig"
